# ========================================================
# AI Provider API Keys (Configure any or all providers)
# Keys can also be configured directly in the app UI settings
# ========================================================

# 1. Google Gemini (Google Search Grounding)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI / ChatGPT (GPT-4o, o3-mini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 3. Anthropic Claude (Claude 3.7 Sonnet, Claude 3.5 Sonnet)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. xAI Grok (Grok 2, Grok Beta)
# https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# 5. Perplexity AI (Sonar Pro, Online Web Citations)
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here
